# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# Nexvi.Meets requires real credentials at runtime. There is deliberately no
# "offline demo mode": a demo that silently ran against throwaway storage and
# reported success is exactly what the audit trail exists to prevent.
# The test suite is the only thing that uses in-memory adapters, and it
# injects them explicitly.

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- MongoDB (required) -----------------------------------------------------
# Local:  docker compose up -d mongo   ->  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nexvi_meets

# --- Groq (primary extractor) ----------------------------------------------
# Get a key at https://console.groq.com
# If this is empty, Nexvi.Meets falls back to the deterministic extractor
# and says so in /readiness and in the UI. It does not fail.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# --- GitHub Issues (required for the side effect) ---------------------------
# Fine-grained PAT with "Issues: read and write" on the sandbox repo only.
# MUST be a test/sandbox repository -- the brief forbids demoing against a
# live production tracker.
GITHUB_TOKEN=
GITHUB_REPO=your-org/nexvi-meets-sandbox

# --- Safety gate ------------------------------------------------------------
# Minimum model confidence for a candidate to be gate-eligible. Raise it to
# make Nexvi.Meets more conservative; it can never be bypassed per-item.
CONFIDENCE_THRESHOLD=0.75

# --- Agent orchestration ----------------------------------------------------
# "inhouse" (default, no extra dependency) or "langgraph".
# Both drive the same agents; if langgraph is unavailable, Nexvi.Meets falls
# back to the in-house graph and says so rather than failing.
AGENT_RUNTIME=inhouse

# --- Sarvam (optional: English + Telugu/Hindi code-switch normalization) ----
# Adds an English rendering ALONGSIDE the original text. Evidence quotes are
# always validated against the original, so translation can never weaken the
# audit trail. Empty = use the original text unchanged.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-translate:v1

# --- Google Calendar (second gated side effect) -----------------------------
# Google Cloud Console -> OAuth consent screen -> OAuth client ID, type
# "Desktop app". Download to backend/credentials.json (gitignored).
# token.json is written beside it after the first consent.
# If neither file exists, the calendar effect is skipped and reported.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary

# --- Cross-meeting memory (ChromaDB, local + persistent, no key) ------------
CHROMA_PERSIST_DIR=./chroma_data
MEMORY_SIMILARITY_THRESHOLD=0.35

# --- Live meeting mode ------------------------------------------------------
LIVE_WINDOW_SECONDS=40
LIVE_MIN_NEW_SEGMENTS=2
