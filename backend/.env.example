# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# CommitGuard requires real credentials at runtime. There is deliberately no
# "offline demo mode": a demo that silently ran against throwaway storage and
# reported success is exactly what the audit trail exists to prevent.
# The test suite is the only thing that uses in-memory adapters, and it
# injects them explicitly.

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- MongoDB (required) -----------------------------------------------------
# Local:  docker compose up -d mongo   ->  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=commitguard

# --- Groq (primary extractor) ----------------------------------------------
# Get a key at https://console.groq.com
# If this is empty, CommitGuard falls back to the deterministic extractor
# and says so in /readiness and in the UI. It does not fail.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# --- GitHub Issues (required for the side effect) ---------------------------
# Fine-grained PAT with "Issues: read and write" on the sandbox repo only.
# MUST be a test/sandbox repository -- the brief forbids demoing against a
# live production tracker.
GITHUB_TOKEN=
GITHUB_REPO=your-org/commitguard-sandbox

# --- Safety gate ------------------------------------------------------------
# Minimum model confidence for a candidate to be gate-eligible. Raise it to
# make CommitGuard more conservative; it can never be bypassed per-item.
CONFIDENCE_THRESHOLD=0.75
